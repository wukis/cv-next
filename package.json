{
  "name": "tailwindui-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.quality.json --noEmit",
    "test": "vitest run",
    "fallow": "fallow dead-code --fail-on-issues --summary && fallow dupes --threshold 0 --summary && fallow health --min-score 85 --summary",
    "fallow:report": "fallow --summary --format compact",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:strict && npm run test && npm run knip && npm run fallow && npm run build",
    "knip": "knip",
    "prepare": "husky",
    "cv:pdf": "npx playwright install chromium && npm run build && node scripts/generate-cv-pdf.mjs",
    "cv:pdf:ensure-staged": "node scripts/ensure-cv-pdf-staged.mjs",
    "linkedin:import": "tsx scripts/linkedin-sync.ts import",
    "linkedin:sync": "tsx scripts/linkedin-sync.ts sync",
    "linkedin:accept": "tsx scripts/linkedin-sync.ts accept",
    "linkedin:restore": "tsx scripts/linkedin-sync.ts restore",
    "lighthouse:home": "node scripts/run-lighthouse.mjs home",
    "lighthouse:experience": "node scripts/run-lighthouse.mjs experience",
    "lighthouse:all": "node scripts/run-lighthouse.mjs all"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "not dead"
  ],
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "adm-zip": "^0.6.0",
    "csv-parse": "^7.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "^3.11.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
